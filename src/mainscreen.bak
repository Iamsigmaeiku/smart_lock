#include <Arduino.h>
#include <TFT_eSPI.h>
#include <XPT2046_Touchscreen.h>
#include "config.h"


TFT_eSPI tft;
XPT2046_Touchscreen ts(TOUCH_CS);

static void drawMarker(int16_t x, int16_t y, uint16_t c) {
  tft.drawFastHLine(x - 12, y, 24, c);
  tft.drawFastVLine(x, y - 12, 24, c);
  tft.drawCircle(x, y, 10, c);
}

void setup() {
  Serial.begin(115200);
  delay(200);

  tft.init();
  tft.setRotation(0);   // 先固定一個你要的顯示方向
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println("Touch Calib");
  tft.setTextSize(1);
  tft.setCursor(10, 35);
  tft.println("Touch 4 corners in order:");

  ts.begin();
  ts.setRotation(0);    // XPT2046 這個多半不可靠，但先放著

  int16_t W = tft.width();
  int16_t H = tft.height();

  // 四角 marker（用你顯示座標）
  drawMarker(10, 10, TFT_RED);             // LT
  drawMarker(W - 11, 10, TFT_RED);         // RT
  drawMarker(10, H - 11, TFT_RED);         // LB
  drawMarker(W - 11, H - 11, TFT_RED);     // RB

  Serial.println("=== Touch each corner: LT, RT, LB, RB ===");
}

static bool waitTouchRaw(int32_t &rx, int32_t &ry) {
  // 等按下
  uint32_t t0 = millis();
  while (!ts.touched()) {
    if (millis() - t0 > 15000) return false;
    delay(5);
  }
  TS_Point p = ts.getPoint();
  rx = p.x; ry = p.y;

  // 等放開（避免連續取樣抖動）
  while (ts.touched()) delay(5);
  delay(150);
  return true;
}

void loop() {
  static int step = 0;
  static int32_t rawx[4], rawy[4];

  const char* name[4] = {"LT", "RT", "LB", "RB"};

  if (step < 4) {
    int32_t rx, ry;
    if (!waitTouchRaw(rx, ry)) {
      Serial.println("Timeout waiting touch.");
      step = 0;
      return;
    }
    rawx[step] = rx;
    rawy[step] = ry;
    Serial.printf("%s raw: x=%ld y=%ld\n", name[step], (long)rx, (long)ry);
    step++;
    if (step == 4) {
      Serial.println("\nPaste these to me. Done.\n");
    }
  }
}
