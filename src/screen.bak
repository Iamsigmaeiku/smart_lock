void Screen::showMainMenu() {
  fillScreen0(0x0000);
  delay(10);

  tft.setTextColor(0xFFFF);
  tft.setTextSize(2);
  setCursor0(70, 10);
  tft.print("Functions");

  // 3列 x 2欄（rows=3 cols=2）—以 240x320 計算
  const int16_t cols = 2;
  const int16_t rows = 3;

  const int16_t marginX = 10;
  const int16_t gapX = 10;
  const int16_t gapY = 12;
  const int16_t topY = 45;
  const int16_t bottomMargin = 12;

  int16_t btnW = (LOG_W - 2 * marginX - (cols - 1) * gapX) / cols;
  int16_t btnH = (LOG_H - topY - bottomMargin - (rows - 1) * gapY) / rows;

  struct Btn { const char *label; uint16_t color; };
  Btn b[6] = {
    {"Finger",   0x07E0},
    {"RFID",     0x07FF},
    {"Password", 0xFFE0},
    {"Face",     0xF81F},
    {"Enroll",   0xFD20},
    {"Setting",  0x8410},
  };

  int idx = 0;
  for (int r = 0; r < rows; r++) {
    for (int c = 0; c < cols; c++) {
      int16_t x0 = marginX + c * (btnW + gapX);
      int16_t y0 = topY    + r * (btnH + gapY);
      drawButton0(x0, y0, btnW, btnH, b[idx].color, b[idx].label, false, 2);
      idx++;
    }
  }
}

void Screen::showPasswordInput() {
  fillScreen0(0x0000);
  delay(10);

  tft.setTextColor(0xFFFF);
  tft.setTextSize(2);
  setCursor0(20, 15);
  tft.print("Enter Password");

  drawRoundRect0(20, 50, 200, 30, 5, 0xFFFF);

  int16_t keyW = 60, keyH = 50;
  int16_t startX = 30, startY = 95;
  int16_t gap = 10;

  String keys[4][3] = {
    {"1", "2", "3"},
    {"4", "5", "6"},
    {"7", "8", "9"},
    {"#", "0", "*"}
  };

  for (int row = 0; row < 4; row++) {
    for (int col = 0; col < 3; col++) {
      int16_t x0 = startX + col * (keyW + gap);
      int16_t y0 = startY + row * (keyH + gap);
      drawButton0(x0, y0, keyW, keyH, 0x4A49, keys[row][col], false, 2);
    }
  }
}

void Screen::updatePasswordDisplay(const String &maskedPW) {
  // 清框（用 fillRoundRect0 以免方向問題）
  // 這裡用 fillRoundRect0 只是偷懶，實際就是 fillRect 的概念
  fillRoundRect0(25, 55, 190, 20, 0, 0x0000);

  tft.setTextColor(0xFFFF);
  tft.setTextSize(2);
  setCursor0(30, 57);
  tft.print(maskedPW);
}

int8_t Screen::getKeypadPress(int16_t x, int16_t y) {
  // ★ 注意：x,y 是 logical0 座標，所以 hitbox 也用 logical0（跟顯示一致）
  int16_t keyW = 60, keyH = 50;
  int16_t startX = 30, startY = 95;
  int16_t gap = 10;

  for (int row = 0; row < 4; row++) {
    for (int col = 0; col < 3; col++) {
      int16_t kx = startX + col * (keyW + gap);
      int16_t ky = startY + row * (keyH + gap);

      if (x >= kx && x <= kx + keyW && y >= ky && y <= ky + keyH) {
        if (row < 3) return row * 3 + col + 1; // 1..9
        if (col == 0) return 10;               // #
        if (col == 1) return 0;                // 0
        return 11;                              // *
      }
    }
  }
  return -1;
}

